    <!-- 计划引擎：周主题 / 每日行动清单 / 小提示（生成计划时按当前语言烘进 plan） -->
    <string name="theme_1">锚定起床与睡前仪式</string>
    <string name="theme_2">光照与咖啡因</string>
    <string name="theme_3">屏幕与卧室环境</string>
    <string name="theme_4">巩固与破功预案</string>
    <string name="task_1_1">固定起床时间到！昨晚几点睡的？给自己打个分（1-5分）</string>
    <string name="task_1_2">起床后 30 分钟内拉开窗帘/到窗边待 10 分钟</string>
    <string name="task_1_3">睡前把手机放到离床 2 米外</string>
    <string name="task_1_4">睡前洗漱 + 5 分钟简单拉伸，固定仪式顺序</string>
    <string name="task_1_5">列出明天最重要的 1 件事，写完就不再想</string>
    <string name="task_2_1">白天光照 ≥ 30 分钟（散步/晒太阳都算）</string>
    <string name="task_2_2">14:00 后不再碰咖啡/浓茶/可乐</string>
    <string name="task_2_3">晚饭不吃太晚太饱，睡前 2 小时结束进食</string>
    <string name="task_2_4">今晚不喝酒（酒精毁掉深睡眠）</string>
    <string name="task_2_5">下午困了就起身走 5 分钟，别靠咖啡续命</string>
    <string name="task_3_1">睡前 45 分钟进入暖光模式：大灯换小灯</string>
    <string name="task_3_2">把明早要用的东西提前收拾好，减少早起决策</string>
    <string name="task_3_3">卧室调凉一点（18–22°C 更易入睡）</string>
    <string name="task_3_4">睡前把手机设为勿扰，通知清零</string>
    <string name="task_3_5">躺下后不刷手机；睡不着就 4-7-8 呼吸法</string>
    <string name="task_4_1">连续 3 天在目标时间前 15 分钟上床，巩固成果</string>
    <string name="task_4_2">想出这周最容易破功的场景，写下一个应对动作</string>
    <string name="task_4_3">周末作息浮动不超过 ±30 分钟</string>
    <string name="task_4_4">把成功的一周告诉一个朋友（社会承诺）</string>
    <string name="task_4_5">给自己定一个 28 天完成奖励</string>
    <string name="tip_1">手机放离床 2 米外，刷手机欲望直接减半</string>
    <string name="tip_2">早起一杯温水 + 10 分钟晨光照射，当晚入睡会更顺利</string>
    <string name="tip_3">躺下睡不着？试试 4-7-8 呼吸法：吸气 4 秒-憋 7 秒-呼气 8 秒</string>
    <string name="tip_4">睡前 30 分钟做拉伸或写日记，比刷手机助眠 10 倍</string>
    <string name="tip_5">周末也保持 ±30 分钟作息浮动，别报复性熬夜</string>
    <string name="tip_6">固定仪式的顺序比时长更重要，让身体学会\'这套动作=要睡了\'</string>

